# Copy to .env.local for development. Never put real secrets in this file.

# Own backend database (docs/backend/README.md): mysql | postgres | mongodb. Unset = memory in dev, refused in
# production. SECRET: the URL holds credentials — set it in the host's secret store / .env.local, never here.
DATABASE_DRIVER=
DATABASE_URL=

# Commerce backend:
#   mock — demo catalogue (dev only; with a database, bags + stock are stored in it)
#   own  — the own backend: products, bags, stock and reviews in the database above (works in production).
#          Fill a local _dev database with the demo catalogue: pnpm db:migrate && pnpm db:seed
#   shopify | medusa — adapters still to be built
COMMERCE_PROVIDER=mock
# CMS: mock (dev only) — Sanity / Contentful / Strapi / Shopify metaobjects pending (PRD §9)
CMS_PROVIDER=mock

# Preview builds only. Mock commerce/CMS and the in-memory consent ledger, newsletter list and grievance inbox,
# and /dev/* pages, are refused in production unless these are exactly "true". Never set either on the live store.
ALLOW_MOCK_DATA=
ENABLE_DEV_PAGES=

# Checkout kill switches (M5). Fail closed: on only when exactly "true". Flip to anything else to pause
# checkout / cash on delivery instantly.
CHECKOUT_ENABLED=
COD_ENABLED=
# Customer accounts (M6: sign-in, orders, returns, privacy actions). Fail closed like the above.
ACCOUNTS_ENABLED=

# Demo payment gateway + demo SMS (shows the OTP on screen). Always on in `next dev`; in a production build only
# when exactly "true" — protected previews only, NEVER on the live store.
ALLOW_MOCK_PAYMENTS=

# Payment gateway: razorpay (hosted Payment Links — UPI, cards, netbanking, wallets). Unset = demo gateway in dev,
# refused in production. Key id is not secret but lives here with the rest; KEY_SECRET and WEBHOOK_SECRET are
# SECRETS (host secret store only). Live keys start rzp_live_ — `pnpm ops:check` refuses rzp_test_ on production.
# Dashboard → Webhooks: URL https://<site>/api/payments/webhook, events payment_link.paid, payment_link.expired,
# payment_link.cancelled, and the same secret as RAZORPAY_WEBHOOK_SECRET.
PAYMENT_GATEWAY=

# SMS (OTP + order updates). India needs a DLT-registered sender ID and DLT-approved templates; we only send
# templates. SMS_PROVIDER = the provider adapter name (none built yet — see docs/known-gaps.md); unset = demo SMS in
# dev (code shown on screen), refused in production. SMS_TEMPLATES = JSON of provider template ids per message:
# {"otp":"…","order_confirmed":"…","order_shipped":"…"} — a message type without an id is simply not sent by SMS.
# Provider credentials (e.g. an auth key) are SECRETS: host secret store only.
SMS_PROVIDER=
SMS_TEMPLATES=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SECRET (set in the host's secret store, never here): ≥ 32 random characters used to hash OTPs. Required in
# production — OTP sign-in refuses to run without it.
OTP_PEPPER=

# SECRET, one-time (M7 admin): ≥ 32 random characters. Needed in production only to create the first owner at
# /admin/setup while no staff exist. Remove it from the host once the owner has signed in.
ADMIN_SETUP_TOKEN=

# SECRET (own backend): 32 random bytes, base64 — encrypts staff TOTP secrets in the database (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". Required in production
# (staff sign-in refuses without it); dev/tests use a fixed dev-only key. To rotate: move the old key to
# SECRET_BOX_PREVIOUS_KEYS (comma-separated), set a new SECRET_BOX_KEY; values re-seal on their next write.
SECRET_BOX_KEY=
SECRET_BOX_PREVIOUS_KEYS=

# Public site URL used in canonical/structured data, e.g. https://www.example.com (no trailing slash)
SITE_URL=

# Legal / contact details shown in every notice (lib/legal/config.ts). Until set, notices show
# "[TO BE PROVIDED: …]" placeholders. These are public business details, not secrets.
LEGAL_ENTITY_NAME=
LEGAL_REGISTERED_ADDRESS=
LEGAL_GSTIN=
LEGAL_JURISDICTION_CITY=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=
PRIVACY_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_DESIGNATION=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

# Trackers (ANL-01). Leave empty until the matching script and Cookie Policy entry ship. When set, the cookie
# banner offers that category, and the script loads only after the visitor accepts it.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
# Google Ads purchase conversion (advertising consent), e.g. AW-123456789 + the conversion label.
GOOGLE_ADS_ID=
GOOGLE_ADS_PURCHASE_LABEL=
# SECRETS (host secret store, never here): server-side events. Nothing is sent unless set, and only for orders
# whose shopper accepted the matching cookies. META_TEST_EVENT_CODE (e.g. TEST12345) routes events to Events Manager
# test view — remove it after validating.
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
GA4_API_SECRET=

# Search engines (CMS-03). Fail closed: robots.txt disallows everything and pages are noindex unless this is
# exactly "true" in a production build with a real SITE_URL and no demo data. Flip it at launch.
ALLOW_INDEXING=

# M9 growth pack.
# SECRET (≥ 32 chars): scheduled sweep /api/cron/sweep (alerts, review requests, abandoned checkout). Sent by the
# scheduler as "Authorization: Bearer <CRON_SECRET>". Unset = the endpoint refuses every call.
CRON_SECRET=
# CHK-08 one-click checkout — off unless exactly "true" AND a known provider + merchant id; the button still won't
# show until that provider's integration is written.
ONE_CLICK_ENABLED=
ONE_CLICK_PROVIDER=
ONE_CLICK_MERCHANT_ID=
# ANL-03 marketing automation (klaviyo | moengage | webengage) — off unless exactly "true"; SECRET key in the host store.
MARKETING_AUTOMATION_ENABLED=
MARKETING_PROVIDER=
MARKETING_API_KEY=

# Footer social profiles (https only; empty = not shown)
SOCIAL_INSTAGRAM_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_X_URL=
