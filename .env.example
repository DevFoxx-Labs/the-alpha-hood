# Copy to .env.local for development. Never put real secrets in this file.

# Commerce backend: mock (dev only) | shopify | medusa  — decision pending (PRD §4)
COMMERCE_PROVIDER=mock
# CMS: mock (dev only) — Sanity / Contentful / Strapi / Shopify metaobjects pending (PRD §9)
CMS_PROVIDER=mock

# Preview builds only. Mock commerce/CMS and the in-memory consent ledger, newsletter list and grievance inbox,
# and /dev/* pages, are refused in production unless these are exactly "true". Never set either on the live store.
ALLOW_MOCK_DATA=
ENABLE_DEV_PAGES=

# Checkout kill switches (M5). Fail closed: on only when exactly "true". Flip to anything else to pause
# checkout / cash on delivery instantly.
CHECKOUT_ENABLED=
COD_ENABLED=
# Customer accounts (M6: sign-in, orders, returns, privacy actions). Fail closed like the above.
ACCOUNTS_ENABLED=

# Demo payment gateway + demo SMS (shows the OTP on screen). Always on in `next dev`; in a production build only
# when exactly "true" — protected previews only, NEVER on the live store.
ALLOW_MOCK_PAYMENTS=

# SECRET (set in the host's secret store, never here): ≥ 32 random characters used to hash OTPs. Required in
# production — OTP sign-in refuses to run without it.
OTP_PEPPER=

# SECRET, one-time (M7 admin): ≥ 32 random characters. Needed in production only to create the first owner at
# /admin/setup while no staff exist. Remove it from the host once the owner has signed in.
ADMIN_SETUP_TOKEN=

# Public site URL used in canonical/structured data, e.g. https://www.example.com (no trailing slash)
SITE_URL=

# Legal / contact details shown in every notice (lib/legal/config.ts). Until set, notices show
# "[TO BE PROVIDED: …]" placeholders. These are public business details, not secrets.
LEGAL_ENTITY_NAME=
LEGAL_REGISTERED_ADDRESS=
LEGAL_GSTIN=
LEGAL_JURISDICTION_CITY=
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_HOURS=
PRIVACY_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_DESIGNATION=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=

# Trackers (ANL-01). Leave empty until the matching script and Cookie Policy entry ship. When set, the cookie
# banner offers that category, and the script loads only after the visitor accepts it.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# Footer social profiles (https only; empty = not shown)
SOCIAL_INSTAGRAM_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_X_URL=
